RUNWEAVE_APP_NAME=RunWeave
RUNWEAVE_HTTP_TIMEOUT_SECONDS=5
RUNWEAVE_HTTP_MAX_CONNECTIONS=128
RUNWEAVE_WORKER_COUNT=128
RUNWEAVE_QUEUE_CAPACITY=1000
RUNWEAVE_HISTORY_MAX_RECORDS=1000
RUNWEAVE_HISTORY_TTL_SECONDS=3600
RUNWEAVE_HISTORY_CLEANUP_INTERVAL_SECONDS=30
RUNWEAVE_RUN_TIMEOUT_SECONDS=30
RUNWEAVE_STEP_TIMEOUT_SECONDS=5
RUNWEAVE_SHUTDOWN_GRACE_SECONDS=5
RUNWEAVE_TOOL_RETRY_ATTEMPTS=3
RUNWEAVE_TOOL_RETRY_BASE_DELAY_SECONDS=0.1
RUNWEAVE_TOOL_RETRY_MAX_DELAY_SECONDS=2
RUNWEAVE_AGENT_MAX_STEPS=7
RUNWEAVE_AGENT_COMPLETION_TOKENS=2048
RUNWEAVE_MODEL_PROVIDER=fake
RUNWEAVE_GROQ_API_KEY=replace_with_your_groq_api_key
RUNWEAVE_GROQ_MODEL=llama-3.3-70b-versatile
RUNWEAVE_GROQ_CONCURRENCY=2
RUNWEAVE_GROQ_REQUESTS_PER_MINUTE=30
RUNWEAVE_JSON_LOGS=false
RUNWEAVE_CONSOLE_TRACES=false
