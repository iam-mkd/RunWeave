RUNWEAVE_APP_NAME=RunWeave
RUNWEAVE_AUTH_MODE=local
RUNWEAVE_TENANT_MAX_UNFINISHED=1000
# For a trusted HS256 issuer, set mode to jwt and configure all three values.
# RUNWEAVE_AUTH_ISSUER=https://your-issuer.example
# RUNWEAVE_AUTH_AUDIENCE=runweave
# RUNWEAVE_AUTH_SIGNING_KEY=replace_with_at_least_32_random_bytes
# Test mode uses a JSON token-to-principal map. See docs/security.md.
# RUNWEAVE_AUTH_TEST_IDENTITIES={"synthetic-alice-token":{"tenant":"a","subject":"alice","scopes":["runs:submit","runs:read","runs:cancel","tools:check_health","tools:lookup_runbook"]}}
RUNWEAVE_PROTECTED_VALUES=[]
RUNWEAVE_HTTP_TIMEOUT_SECONDS=5
RUNWEAVE_HTTP_MAX_CONNECTIONS=128
RUNWEAVE_WORKER_COUNT=128
RUNWEAVE_QUEUE_CAPACITY=1000
RUNWEAVE_HISTORY_MAX_RECORDS=1000
RUNWEAVE_HISTORY_TTL_SECONDS=3600
RUNWEAVE_HISTORY_CLEANUP_INTERVAL_SECONDS=30
RUNWEAVE_RUN_TIMEOUT_SECONDS=30
RUNWEAVE_STEP_TIMEOUT_SECONDS=5
RUNWEAVE_SHUTDOWN_GRACE_SECONDS=5
RUNWEAVE_TOOL_RETRY_ATTEMPTS=3
RUNWEAVE_TOOL_RETRY_BASE_DELAY_SECONDS=0.1
RUNWEAVE_TOOL_RETRY_MAX_DELAY_SECONDS=2
RUNWEAVE_AGENT_MAX_STEPS=7
RUNWEAVE_AGENT_COMPLETION_TOKENS=2048
RUNWEAVE_AGENT_REQUEST_LIMIT=20
RUNWEAVE_AGENT_INPUT_TOKENS=100000
RUNWEAVE_AGENT_CONTEXT_TOKENS=16384
RUNWEAVE_AGENT_EVIDENCE_BYTES=2048
RUNWEAVE_AGENT_MAX_COST_USD=0.05
# Groq mode requires your model/tier rates and a version identifying that price configuration.
# RUNWEAVE_MODEL_INPUT_USD_PER_MILLION=<your_input_rate>
# RUNWEAVE_MODEL_OUTPUT_USD_PER_MILLION=<your_output_rate>
# RUNWEAVE_MODEL_PRICE_VERSION=<your_contract_or_price_revision>
RUNWEAVE_AGENT_WORKFLOW=baseline
RUNWEAVE_MODEL_PROVIDER=fake
RUNWEAVE_GROQ_API_KEY=replace_with_your_groq_api_key
RUNWEAVE_GROQ_MODEL=llama-3.3-70b-versatile
RUNWEAVE_GROQ_CONCURRENCY=2
RUNWEAVE_GROQ_REQUESTS_PER_MINUTE=30
RUNWEAVE_JSON_LOGS=false
RUNWEAVE_CONSOLE_TRACES=false
# RUNWEAVE_DATABASE_URL=postgresql+asyncpg://runweave:replace_me@127.0.0.1:5432/runweave
RUNWEAVE_DB_POOL_SIZE=8
RUNWEAVE_LEASE_SECONDS=6
RUNWEAVE_DB_POLL_SECONDS=0.25
RUNWEAVE_DURABLE_MAX_ATTEMPTS=3
RUNWEAVE_DURABLE_RETRY_DELAY_SECONDS=0.5
RUNWEAVE_APPROVAL_TTL_SECONDS=3600
RUNWEAVE_APPROVAL_MAX_PENDING=100
# Revoke a tenant/subject on every replica before resuming its approved effects.
RUNWEAVE_AUTH_REVOKED_SUBJECTS=[]
RUNWEAVE_MEMORY_TTL_SECONDS=604800
RUNWEAVE_MEMORY_MAX_RECORDS=10000
RUNWEAVE_MEMORY_MAX_PER_TENANT=1000
RUNWEAVE_MEMORY_MAX_PER_SCOPE=100
RUNWEAVE_MEMORY_RECALL_LIMIT=5
RUNWEAVE_MEMORY_RECALL_BYTES=4096
# Tenant -> project -> allowed subject names; no project sharing by default.
RUNWEAVE_MEMORY_PROJECT_MEMBERSHIPS={}
