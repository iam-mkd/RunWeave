{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RunWeave",
  "version": "0.1.1",
  "identifier": "dev.runweave.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "RunWeave contributors",
    "license": "Apache-2.0",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Run and test your agents under load, faults and evaluations",
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../../target/sidecar/runweave-desktop-service/": "sidecar/",
      "../../target/postgres-archive/postgres.txz": "postgres/postgres.txz",
      "../../target/notices/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
